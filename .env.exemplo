# Copiar para .env e preencher os segredos antes de arrancar.
# Os scripts npm passam --env-file=.env ao Node para carregar estas variáveis.
# Porta em que o servidor HTTPS aceita ligações.
PORT=3000
# Segredo usado para assinar e verificar JWT; deve ser aleatório e mantido privado.
JWT_SECRET=
# Duração dos tokens emitidos no login: 1h significa uma hora.
JWT_EXPIRA=1h
# Chave AES-256: 32 bytes representados por 64 caracteres hexadecimais.
# Mudar esta chave impede desencriptar os telefones guardados com a anterior.
CHAVE_ENCRIPTACAO=
# Chave partilhada das estatísticas; o middleware exige pelo menos 32 caracteres.
API_KEY=
# Endpoint do Arquivo.pt. Nos testes pode apontar para o simulador local.
ARQUIVO_URL=https://arquivo.pt/textsearch
# Tempo máximo da consulta externa, incluindo a leitura do JSON (milissegundos).
ARQUIVO_TIMEOUT_MS=5000
# Caminhos para a chave privada e para o certificado HTTPS do servidor.
SSL_KEY=certs/key.pem
SSL_CERT=certs/cert.pem
