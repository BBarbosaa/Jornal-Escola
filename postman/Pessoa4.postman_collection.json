            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Token recebido', () => pm.expect(pm.response.json().token).to.be.a('string').and.not.empty);",
              "pm.environment.set('token', pm.response.json().token);"
            ]
          }
        }
      ]
    },
