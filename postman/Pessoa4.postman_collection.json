{
  "info": {
    "name": "Pessoa 4 — Fontes, Arquivo.pt e testes",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Executar por ordem com o simulador scripts/arquivo-mock.mjs e ARQUIVO_URL local. Não executar estes cenários simulados contra o Arquivo.pt real."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('Contrato JSON ou 204 vazio', () => { if (pm.response.code === 204) { pm.expect(pm.response.text()).to.eql(''); } else { pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'); const dados = pm.response.json(); if (pm.response.code >= 400) pm.expect(dados.erro).to.be.a('string').and.not.empty; } });"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 Registar jornalista",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/registo",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\"nome\":\"Pessoa Quatro\",\"email\":\"{{emailTeste}}\",\"password\":\"Teste123!\",\"telefone\":\"912345678\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.environment.set('emailTeste', 'pessoa4-' + pm.variables.replaceIn('{{$guid}}') + '@exemplo.pt');",
              "pm.environment.unset('token');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "pm.environment.set('jornalistaId', pm.response.json().id);",
              "pm.test('Sem password na resposta', () => pm.expect(pm.response.json()).not.to.have.property('password'));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Login e guardar token",
